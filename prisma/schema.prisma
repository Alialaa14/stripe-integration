// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  name             String?
  password         String
  stripeCustomerId String?           @unique
  customer         StripeCustomer?
  subscriptions    Subscription[]
  payments         Payment[]
  setupIntents     SetupIntent[]
  invoices         Invoice[]
  checkoutSessions CheckoutSession[]
  accounts         StripeAccount[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model StripeCustomer {
  id                     String            @id @default(cuid())
  stripeCustomerId       String            @unique
  userId                 String            @unique
  user                   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  email                  String?
  name                   String?
  currency               String?
  defaultPaymentMethodId String?
  subscriptions          Subscription[]
  payments               Payment[]
  setupIntents           SetupIntent[]
  invoices               Invoice[]
  checkoutSessions       CheckoutSession[]
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
}

model Product {
  id                  String   @id @default(cuid())
  stripeProductId     String   @unique
  name                String
  slug                String   @unique
  sku                 String?  @unique
  description         String?
  category            String?
  brand               String?
  images              String[] @default([])
  unitLabel           String?
  shippable           Boolean  @default(false)
  statementDescriptor String?
  taxCode             String?
  url                 String?
  active              Boolean  @default(true)
  metadata            Json?
  prices              Price[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Price {
  id            String                @id @default(cuid())
  stripePriceId String                @unique
  productId     String
  product       Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  active        Boolean               @default(true)
  currency      String
  unitAmount    Int?
  nickname      String?
  taxBehavior   TaxBehavior           @default(un_specified)
  recurring     Boolean               @default(false)
  interval      BillingInterval?
  intervalCount Int?
  subscriptions SubscriptionItem[]
  checkoutItems CheckoutSessionItem[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
}

model Subscription {
  id                   String             @id @default(cuid())
  stripeSubscriptionId String             @unique
  userId               String
  customerId           String
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer             StripeCustomer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status               SubscriptionStatus
  cancelAtPeriodEnd    Boolean            @default(false)
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  canceledAt           DateTime?
  endedAt              DateTime?
  items                SubscriptionItem[]
  invoices             Invoice[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model SubscriptionItem {
  id                       String       @id @default(cuid())
  stripeSubscriptionItemId String       @unique
  subscriptionId           String
  priceId                  String
  subscription             Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  price                    Price        @relation(fields: [priceId], references: [id])
  quantity                 Int          @default(1)
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
}

model Payment {
  id                    String             @id @default(cuid())
  stripePaymentIntentId String             @unique
  userId                String
  customerId            String?
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer              StripeCustomer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  amount                Int
  amountReceived        Int                @default(0)
  currency              String
  status                PaymentStatus
  paymentMethodId       String?
  captureMethod         CaptureMethod      @default(automatic)
  confirmationMethod    ConfirmationMethod @default(automatic)
  setupFutureUsage      SetupFutureUsage?
  receiptEmail          String?
  description           String?
  statementDescriptor   String?
  cancellationReason    String?
  receiptUrl            String?
  failureCode           String?
  failureMessage        String?
  metadata              Json?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
}

model SetupIntent {
  id                  String            @id @default(cuid())
  stripeSetupIntentId String            @unique
  userId              String
  customerId          String?
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer            StripeCustomer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  paymentMethodId     String?
  status              SetupIntentStatus
  usage               SetupIntentUsage  @default(off_session)
  description         String?
  cancellationReason  String?
  failureCode         String?
  failureMessage      String?
  metadata            Json?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

model Invoice {
  id               String         @id @default(cuid())
  stripeInvoiceId  String         @unique
  userId           String
  customerId       String
  subscriptionId   String?
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer         StripeCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subscription     Subscription?  @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  number           String?
  amountDue        Int
  amountPaid       Int            @default(0)
  amountRemaining  Int            @default(0)
  currency         String
  status           InvoiceStatus
  hostedInvoiceUrl String?
  invoicePdf       String?
  dueDate          DateTime?
  paidAt           DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model WebhookEvent {
  id            String    @id @default(cuid())
  stripeEventId String    @unique
  type          String
  apiVersion    String?
  payload       Json
  processed     Boolean   @default(false)
  processedAt   DateTime?
  error         String?
  createdAt     DateTime  @default(now())
}

model CheckoutSession {
  id                      String                @id @default(cuid())
  stripeCheckoutSessionId String                @unique
  userId                  String
  customerId              String?
  user                    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer                StripeCustomer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status                  CheckoutSessionStatus @default(open)
  mode                    CheckoutMode          @default(payment)
  currency                String?
  amountTotal             Int?
  url                     String?
  expiresAt               DateTime?
  completedAt             DateTime?
  metadata                Json?
  lineItems               CheckoutSessionItem[]
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  @@index([userId, createdAt])
}

model CheckoutSessionItem {
  id                String          @id @default(cuid())
  checkoutSessionId String
  priceId           String
  quantity          Int             @default(1)
  checkoutSession   CheckoutSession @relation(fields: [checkoutSessionId], references: [id], onDelete: Cascade)
  price             Price           @relation(fields: [priceId], references: [id])
  createdAt         DateTime        @default(now())

  @@unique([checkoutSessionId, priceId])
}

model StripeAccount {
  id                    String    @id @default(cuid())
  stripeAccountId       String    @unique
  userId                String?
  user                  User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName           String?
  contactEmail          String?
  contactPhone          String?
  dashboard             String?
  appliedConfigurations String[]  @default([])
  livemode              Boolean   @default(false)
  closed                Boolean   @default(false)
  closedAt              DateTime?
  configuration         Json?
  defaults              Json?
  identity              Json?
  requirements          Json?
  metadata              Json?
  raw                   Json
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

enum BillingInterval {
  day
  week
  month
  year
}

enum TaxBehavior {
  inclusive
  exclusive
  un_specified
}

enum SubscriptionStatus {
  incomplete
  incomplete_expired
  trialing
  active
  past_due
  canceled
  unpaid
  paused
}

enum PaymentStatus {
  requires_payment_method
  requires_confirmation
  requires_action
  processing
  requires_capture
  succeeded
  canceled
}

enum CaptureMethod {
  automatic
  automatic_async
  manual
}

enum ConfirmationMethod {
  automatic
  manual
}

enum SetupFutureUsage {
  on_session
  off_session
}

enum SetupIntentStatus {
  requires_payment_method
  requires_confirmation
  requires_action
  processing
  canceled
  succeeded
}

enum SetupIntentUsage {
  on_session
  off_session
}

enum InvoiceStatus {
  draft
  open
  paid
  uncollectible
  void
}

enum CheckoutSessionStatus {
  open
  complete
  expired
}

enum CheckoutMode {
  payment
  subscription
  setup
}
